        "semitones": 5,
        "direction": "up",
        "scaleSteps": 3,
        "alter": 0
      },
      "sourceChords": ["Dm7", "G7", "Cmaj7"],
      "expectedTransposedChords": ["Gm7", "C7", "Fmaj7"],
      "expectedKeyTransposition": {
        "fromTonic": "C",
        "toTonic": "F"
      }
    },
    {
      "id": "TRANSPOSE_MINOR_THIRD_DOWN",
