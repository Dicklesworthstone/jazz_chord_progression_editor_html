{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "cases": [
    {
      "id": "TRANSPOSE_MAJOR_SECOND_UP",
      "name": "Transpose C Major ii-V-I up a Major 2nd to D Major",
      "interval": {
        "diatonicNumber": 2,
        "quality": "major",
        "semitones": 2,
        "direction": "up",
        "scaleSteps": 1,
        "alter": 0
      },
      "sourceChords": ["Dm7", "G7", "Cmaj7"],
      "expectedTransposedChords": ["Em7", "A7", "Dmaj7"],
      "expectedKeyTransposition": {
        "fromTonic": "C",
        "toTonic": "D"
      }
    },
    {
      "id": "TRANSPOSE_PERFECT_FOURTH_UP",
