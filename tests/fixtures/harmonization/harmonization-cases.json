{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "cases": [
    {
      "id": "CASE_HARMONIZE_MELODY_C_LINE",
      "name": "Harmonize descending melody line E4 -> D4 -> C4",
      "slots": [
        {
          "slotIndex": 0,
          "melodyPitch": { "step": "E", "alter": 0, "octave": 4 },
          "expectedChords": ["Cmaj7", "Em7", "Am7"]
        },
        {
          "slotIndex": 1,
          "melodyPitch": { "step": "D", "alter": 0, "octave": 4 },
          "expectedChords": ["G7", "Dm7", "Bbmaj7"]
