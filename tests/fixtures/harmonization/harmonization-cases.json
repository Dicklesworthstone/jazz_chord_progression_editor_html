      "expectedSolutionProgression": ["Cmaj7"]
    },
    {
      "id": "CASE_HARMONIZE_PINNED_CHORD_PRESERVATION",
      "name": "Preserve pinned chord while harmonizing surrounding slots",
      "slots": [
        {
          "slotIndex": 0,
          "melodyPitch": { "step": "A", "alter": 0, "octave": 4 },
          "expectedChords": ["Dm7", "Fmaj7"]
