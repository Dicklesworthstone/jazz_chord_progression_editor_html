        {
          "slotIndex": 2,
          "melodyPitch": { "step": "C", "alter": 0, "octave": 4 },
          "expectedChords": ["Cmaj7", "Am7", "Fmaj7"]
        }
      ],
      "expectedSolutionProgression": ["Cmaj7", "G7", "Cmaj7"]
    },
    {
      "id": "CASE_HARMONIZE_BASS_PEDAL_LINE",
      "name": "Harmonize with pinned C tonic bass pedal and melody G4",
