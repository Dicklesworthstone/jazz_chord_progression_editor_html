{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "mutationControls": [
    {
      "id": "MUTATION_EMPTY_EVENTS",
      "description": "Empty progression events supplied for tension curve or rhythm transform",
      "corruptedField": "events",
      "expectedRefusal": "g7.empty_events"
    },
    {
      "id": "MUTATION_EVENTS_EXCEEDED",
      "description": "Events count exceeds limit of 64",
      "corruptedField": "eventsCount",
      "expectedRefusal": "g7.events_exceeded"
    },
    {
      "id": "MUTATION_INVALID_CHORD",
      "description": "Event contains invalid unparseable chord syntax",
      "corruptedField": "chordSymbol",
      "expectedRefusal": "g7.invalid_chord"
    },
    {
      "id": "MUTATION_STALE_REVISION",
      "description": "Stale revision supplied for rhythm transform",
      "corruptedField": "baseRevision",
      "expectedRefusal": "g7.stale_revision"
    }
  ]
}
