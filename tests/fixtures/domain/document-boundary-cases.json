{
  "schema": "changes.fixtures.f1-document-boundary.v1",
  "defaultSeedId": "F1-SEED-BOUNDARY",
  "idSyntax": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
    "maximumAsciiCharacters": 128,
    "caseSensitive": true,
    "scope": "global across all persisted ID kinds"
  },
  "specialInputDescriptors": {
    "repeatAscii": "materialize the named ASCII character count before decoding",
    "repeatCodePoint": "materialize the Unicode scalar value count before decoding",
    "specialNumber": "materialize NaN or positive/negative Infinity at the total runtime decoder boundary",
    "loneSurrogate": "materialize exactly one unpaired UTF-16 surrogate code unit",
    "utf8Bytes": "materialize an input byte sequence of exactly the declared UTF-8 length; byte preflight runs before JSON parsing",
    "jsonNestingDepth": "materialize alternating object/array containers with the root container counted as depth one",
    "shapeCount": "materialize a structurally minimal valid collection with the declared count and globally unique IDs"
  },
  "textValidationMatrix": {
    "fields": ["documentTitle", "documentDescription", "sectionName", "annotation", "chordSourceText", "customChordLabel", "partialMeasureReason", "engineVersion"],
    "lengthUnit": "Unicode scalar values",
    "rejects": ["unpaired high surrogate", "unpaired low surrogate"],
    "nonblankCheck": "ECMAScript String.prototype.trim for required fields only; blank iff the trimmed UTF-16 string has length zero",
    "discriminatorCases": {"U+FEFF": "blank", "U+0085": "nonblank"},
    "storedValuePolicy": "preserve the original nonblank string without trimming or normalization"
  },
  "cases": [
