      "meter": {"beatsPerBar": 4, "beatUnit": 4},
      "eventDurations": [{"numerator": 5, "denominator": 1}],
      "completion": {"kind": "incomplete", "expectedDuration": {"numerator": 5, "denominator": 1}, "reason": "Overfilled incomplete bar"},
      "expected": {
        "ok": false,
        "issuesInOrder": [
          {"code": "measure.expected_duration_not_short", "path": ["completion", "expectedDuration"]},
          {"code": "measure.duration_over_capacity", "path": ["events", 0, "duration"]}
        ]
      }
    },
    {
