      "meter": {"beatsPerBar": 4, "beatUnit": 4},
      "eventDurations": [],
      "completion": {"kind": "complete"},
      "expected": {
        "ok": false,
        "issuesInOrder": [
          {"code": "measure.complete_duration_mismatch", "path": ["completion"]},
          {"code": "measure.nonempty_has_no_events", "path": ["events"]}
        ]
      }
    },
    {
