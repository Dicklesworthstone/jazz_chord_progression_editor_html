      "meter": {"beatsPerBar": 3, "beatUnit": 8},
      "eventDurations": [
        {"numerator": 1, "denominator": 2},
        {"numerator": 1, "denominator": 1}
      ],
      "completion": {"kind": "complete"},
      "expected": {"ok": true, "sum": {"numerator": 3, "denominator": 2}}
    },
    {
      "id": "F1-MEASURE-020",
      "traceIds": ["F1-TRACE-MEASURE-STATE"],
