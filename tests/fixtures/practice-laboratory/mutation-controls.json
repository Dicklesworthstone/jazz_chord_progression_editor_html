{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "mutationControls": [
    {
      "id": "MUTATION_EMPTY_EVENTS",
      "description": "Empty progression events supplied for practice session generation",
      "corruptedField": "events",
      "expectedRefusal": "g9.empty_events"
    },
    {
      "id": "MUTATION_PROMPTS_EXCEEDED",
      "description": "Requested prompts count exceeds limit of 32",
      "corruptedField": "maxPrompts",
      "expectedRefusal": "g9.prompts_exceeded"
    },
    {
      "id": "MUTATION_INVALID_CHORD",
      "description": "Event contains invalid unparseable chord syntax",
      "corruptedField": "chordSymbol",
      "expectedRefusal": "g9.invalid_chord"
    },
    {
      "id": "MUTATION_STALE_REVISION",
      "description": "Stale revision supplied for practice session",
      "corruptedField": "baseRevision",
      "expectedRefusal": "g9.stale_revision"
    }
  ]
}
