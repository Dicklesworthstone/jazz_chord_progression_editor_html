    {"id":"C0-NOTE-005","dimension":"note-trust","given":{"notes":["C4tail"]},"expected":{"trusted":false,"reason":"full-string match required"}},
    {"id":"C0-NOTE-006","dimension":"note-trust","given":{"notes":["C4",60]},"expected":{"trusted":false,"reason":"every member must be a string"}},
    {"id":"C0-NOTE-007","dimension":"note-trust","given":{"notes":[]},"expected":{"trusted":false,"reason":"nonempty"}},
    {"id":"C0-NOTE-008","dimension":"note-trust","given":"17 otherwise valid note strings","expected":{"trusted":false,"reason":"maximum 16"}},
    {"id":"C0-NOTE-009","dimension":"note-trust","given":{"notes":["C-2"]},"expected":{"trusted":false,"reason":"MIDI below zero"}},
    {"id":"C0-NOTE-010","dimension":"note-trust","given":{"notes":["C##4","D4"]},"expected":{"trusted":false,"reason":"duplicate projected MIDI"}},
    {"id":"C0-NOTE-011","dimension":"note-trust","given":{"notes":["C3","G3","C4"]},"expected":{"trusted":true,"manualOrder":"unchanged","doublings":"unchanged"}},
