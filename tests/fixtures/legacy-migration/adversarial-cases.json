{
  "schema": "changes.fixtures.c0-adversarial-cases.v1",
  "cases": [
    {"id":"C0-PRE-001","dimension":"precedence","given":"name parses and trusted notes are an exact-written subset of one realization","expected":{"outcome":"parsed-manual","reportCodes":["legacy.preserved.symbol","legacy.preserved.manual_notes"]}},
    {"id":"C0-PRE-002","dimension":"precedence","given":"name parses and notes are absent","expected":{"outcome":"parsed-auto","reportCodes":["legacy.canonicalized.auto_voicing_default"]}},
    {"id":"C0-PRE-003","dimension":"precedence","given":"name parses and trusted notes agree by sounding pitch class but not written spelling","expected":{"outcome":"custom-manual","reportCodes":["legacy.custom.name_notes_spelling_conflict"]}},
    {"id":"C0-PRE-004","dimension":"precedence","given":"name parses and trusted notes are not a sounding subset of any one realization","expected":{"outcome":"custom-manual","reportCodes":["legacy.custom.name_notes_sounding_conflict"]}},
    {"id":"C0-PRE-005","dimension":"precedence","given":"name fails, root and allow-listed type construct a symbol, and trusted notes agree","expected":{"outcome":"parsed-manual","reportCodes":["legacy.ignored.name_parse_failure","legacy.canonicalized.symbol_from_root_type"]}},
    {"id":"C0-PRE-006","dimension":"precedence","given":"name fails, root and allow-listed type construct a symbol, and trusted notes disagree","expected":{"outcome":"custom-manual","reportCodes":["legacy.ignored.name_parse_failure","legacy.custom.constructed_notes_conflict"]}},
    {"id":"C0-PRE-007","dimension":"precedence","given":"no parseable symbol exists but trusted notes exist","expected":{"outcome":"custom-manual","reportCodes":["legacy.custom.notes_without_symbol"]}},
    {"id":"C0-PRE-008","dimension":"precedence","given":"neither a parseable symbol nor trusted notes exist","expected":{"outcome":"rejected-event","reportCodes":["legacy.rejected.no_usable_symbol_or_notes"]}},
    {"id":"C0-PRE-009","dimension":"alteration-flags","given":"name is absent and every true flag maps to a supported modifier","expected":{"outcome":"construct-with-flags","flagOrder":["b5","s5","b9","s9","s11","b13"]}},
    {"id":"C0-PRE-010","dimension":"alteration-flags","given":"name parses and a true flag agrees or disagrees","expected":{"outcome":"parsed-name-unchanged","reportCodes":["legacy.ignored.alteration_evidence"]}},
    {"id":"C0-PRE-011","dimension":"alteration-flags","given":"name is present but fails to parse and flags are true","expected":{"outcome":"construct-without-flags","reportCodes":["legacy.ignored.name_parse_failure","legacy.ignored.alteration_evidence"]}},
    {"id":"C0-PRE-012","dimension":"type-map","given":"type is 7sus4 while 7b9sus4 is allow-listed","expected":{"outcome":"unknown-exact-type","reportCodes":["legacy.ignored.unknown_type"]}},
    {"id":"C0-PRE-013","dimension":"slash-bass","given":"trusted Manual notes contain the exact written slash bass at the minimum MIDI","expected":{"outcome":"included-bass","comparison":"exclude exact-spelled lowest bass unisons only"}},
    {"id":"C0-PRE-014","dimension":"slash-bass","given":"a parsed slash bass is absent from the minimum MIDI pitches","expected":{"outcome":"custom-manual","semanticBass":null,"reportCodes":["legacy.custom.name_notes_sounding_conflict"]}},
    {"id":"C0-PRE-015","dimension":"altered-realization","given":"stored notes take degrees from two different altered realizations","expected":{"outcome":"custom-manual","unionRealizations":false}},
    {"id":"C0-PRE-016","dimension":"custom","given":"a conflict becomes Custom","expected":{"label":"preserve nonempty legacy name","bass":null,"pitchNames":"stable first written occurrence","voicing":"exact Manual included"}},

    {"id":"C0-NOTE-001","dimension":"note-trust","given":{"notes":["C4"]},"expected":{"trusted":true,"midi":[60]}},
