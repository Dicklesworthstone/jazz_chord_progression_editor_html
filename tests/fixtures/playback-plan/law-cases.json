      "traceIds": ["P0-TRACE-TRANSPOSITION", "P0-TRACE-MIDI", "P0-TRACE-DETERMINISM"],
      "authorityIds": ["P0-AUTH-T0", "P0-AUTH-T1", "P0-AUTH-INDEPENDENCE"]
