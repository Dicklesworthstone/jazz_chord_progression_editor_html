      "traceIds": ["P0-TRACE-DETERMINISM", "P0-TRACE-SOURCE-IDS", "P0-TRACE-REALIZATION"],
      "authorityIds": ["P0-AUTH-CONTRACT", "P0-AUTH-INDEPENDENCE"]
    },
    {
      "id": "P0-LAW-003",
      "law": "exact-midi-mirror",
      "description": "Every beat position and duration has an exact integer PPQ-960 mirror; no rounding is allowed.",
      "inputRefs": ["timeline-cases.json#P0-TIME-001", "loop-cases.json#P0-LOOP-009"],
      "expectedRelation": {
        "midiPpq": 960,
        "forEveryEvent": [
          "sourceStartTick = sourceStartBeat * 960",
          "sourceDurationTicks = sourceDurationBeats * 960",
          "sourceOffsetTicks is null iff sourceOffsetBeats is null",
          "startTick = startBeat * 960",
          "durationTicks = durationBeats * 960",
          "gateDurationTicks = gateDurationBeats * 960",
          "pitches.length = midiPitches.length",
          "midiPitches[i] is the exact equal-temperament projection of pitches[i]"
        ],
        "totalTicks": "totalBeats * 960",
        "loopTicks": "null iff loop is null; otherwise exact endpoint projection"
      },
      "nearMissRef": "realization-cases.json#P0-REAL-021",
      "traceIds": ["P0-TRACE-MIDI", "P0-TRACE-GATE"],
      "authorityIds": ["P0-AUTH-DOMAIN", "P0-AUTH-CONTRACT"]
    },
    {
