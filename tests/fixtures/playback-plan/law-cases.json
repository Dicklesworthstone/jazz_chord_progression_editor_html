  "status": "independently-authored-pre-production",
  "productionOutputUsed": false,
  "expectedValuesGenerated": false,
  "lawPolicy": {
    "byteEquivalent": "Canonical JSON uses the public own-key orders, UTF-8, LF, no insignificant whitespace, and no locale-sensitive sorting.",
    "transposition": "The test-only transposer uses checked-in T0/T1 spelling expectations and shares no playback compiler code.",
    "mutation": "Mutation controls are named in mutation-controls.json and must be killed without updating an expected fixture from production output.",
    "consumerProof": "Audio and MIDI test consumers receive the same frozen PlaybackPlan object; neither may normalize, realize, or repair it."
  },
  "cases": [
    {
      "id": "P0-LAW-001",
      "law": "deterministic-replay",
      "description": "Two deeply equal requests compile to byte-equivalent result, plan, refusal, and work evidence records.",
      "inputRef": "timeline-cases.json#P0-TIME-001",
      "repetitions": 3,
      "expectedRelation": {
        "canonicalBytesEqual": true,
        "ownKeyOrderExact": true,
        "ambientInputsThatMayNotChangeOutput": ["clock", "date", "locale", "timezone", "random", "map-insertion-order", "object-allocation-order"]
      },
      "nearMiss": {
        "change": "tempoBpm 120 to 121",
        "expectedDifferentPaths": [["plan", "tempoBpm"]],
        "allBeatTickPitchPathsEqual": true
      },
      "traceIds": ["P0-TRACE-DETERMINISM", "P0-TRACE-BOUNDARY"],
      "authorityIds": ["P0-AUTH-CONTRACT", "P0-AUTH-INDEPENDENCE"]
    },
    {
      "id": "P0-LAW-002",
      "law": "binding-map-order-invariance",
      "description": "Reversing realization-map insertion order does not change semantic output or evidence.",
      "inputRef": "timeline-cases.json#P0-TIME-001",
