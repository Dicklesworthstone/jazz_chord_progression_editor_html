      "id": "U5-STACK-001",
      "kind": "positive",
      "subject": "lifecycle dialog pushes onto the A0 stack",
      "given": "a New gesture with dirty state",
      "expected": "one DialogDescriptor with kind new-document phase open; blocksHistory per kind; announce once",
      "lawIds": [
        "U5-LAW-STACK-HOSTING"
      ],
      "traceIds": [
        "TR-U5-DIALOG-STACK"
      ],
      "authorityIds": [
