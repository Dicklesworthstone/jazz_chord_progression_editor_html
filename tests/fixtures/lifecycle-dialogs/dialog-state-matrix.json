      ]
    },
    {
      "id": "U5-STACK-002",
      "kind": "limit",
      "subject": "stack overflow refuses",
      "given": "eight open dialogs and a ninth push",
      "expected": "refusal dialog.stack_limit; nothing changes",
      "lawIds": [
        "U5-LAW-STACK-HOSTING"
      ],
      "traceIds": [
        "TR-U5-DIALOG-STACK"
      ],
      "authorityIds": [
        "U5-AUTH-A0"
      ]
    },
    {
      "id": "U5-STACK-003",
      "kind": "negative",
      "subject": "pop removes only the top",
      "given": "a pop-dialog intent naming a non-top dialog id",
      "expected": "refusal; the stack is unchanged",
      "lawIds": [
        "U5-LAW-STACK-HOSTING"
      ],
      "traceIds": [
        "TR-U5-DIALOG-STACK"
      ],
      "authorityIds": [
        "U5-AUTH-A0"
      ]
    },
    {
      "id": "U5-STACK-004",
      "kind": "negative",
