  "duplicateCases": [
    {
      "id": "duplicate-object-method",
      "source": "const service = { run() {}, run() {} };",
      "expected": "reject",
      "codes": [
        "SOURCE_DUPLICATE_MEMBER"
      ]
    },
    {
      "id": "duplicate-object-property",
      "source": "const state = { status: 'idle', status: 'playing' };",
      "expected": "reject",
      "codes": [
        "SOURCE_DUPLICATE_MEMBER"
      ]
    },
    {
      "id": "duplicate-class-method",
      "source": "class Transport { stop() {} stop() {} }",
      "expected": "reject",
      "codes": [
        "SOURCE_DUPLICATE_MEMBER"
      ]
    },
    {
      "id": "accessor-pair",
      "source": "class Meter { get value() { return 1; } set value(next: number) { void next; } }",
      "expected": "allow",
      "codes": []
    },
    {
      "id": "overload-set",
      "source": "class Parser { parse(value: string): string; parse(value: number): number; parse(value: string | number) { return value; } }",
      "expected": "allow",
      "codes": []
    },
    {
      "id": "computed-members-not-guessed",
      "source": "const a = 'x'; const b = 'x'; const value = { [a]: 1, [b]: 2 };",
      "expected": "allow",
      "codes": []
    }
  ],
  "artifactCases": [
