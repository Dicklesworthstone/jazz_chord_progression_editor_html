# Database
*.db
*.db-journal
*.db-shm
*.db-wal
# fsqlite namespace sidecars written beside the db by beads_rust
*.db-fsqlite-*
# Vacuum copies use `.vacuum-fsqlite-ns-{gate,use}`, which `*.db-fsqlite-*` misses
*-fsqlite-ns-gate
*-fsqlite-ns-use

# WAL certification sidecars (`*.db-wal` does not match these)
*.db-wal-cert
*.db-wal-cert-head
# Schema migration scratch databases retain these local support files.
*.vacuum-wal-cert*
*.fsqlite-migration-state

# Lock files
*.lock
.write.lock

# Temporary
last-touched
*.tmp

# Local history backups
.br_history/

# DB-family recovery artifacts (truncated WAL/SHM, quarantined sidecars)
# — same lifecycle as .br_history/, written by recovery paths and
# `br doctor --repair`. Filename suffix `.truncated-wal` slips past the
# generic `*.db-wal` glob above, so it needs an explicit entry (#271).
.br_recovery/

# Sync state (local-only, per-machine)
.sync.lock
sync_base.jsonl

# Merge artifacts (temporary files from 3-way merge)
beads.base.jsonl
beads.base.meta.json
beads.left.jsonl
beads.left.meta.json
beads.right.jsonl
beads.right.meta.json

# Daemon runtime files
daemon.lock
daemon.log
daemon.pid
bd.sock
sync-state.json

# Worktree redirect file
redirect

# bv (beads viewer) lock file
.bv.lock
