{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "playwright.config.ts",
    "playwright.x0.config.ts",
    "tests/integration/audio-offline-render.test.ts",
    "tests/e2e/**/*.ts",
    "tests/e2e/**/*.tsx",
    "tests/visual/**/*.ts",
    "tests/visual/**/*.tsx"
  ]
}
